  "actions": [
    {
      "type": "Action.Execute",
      "title": "Submit claim",
      "verb": "submit",
      "style": "positive"
    },
    {
      "type": "Action.Submit",
      "title": "Make a change",
      "data": {
        "msteams": {
          "type": "task/fetch"
        },
        "open": "change"
      }
    }
  ]
