{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "msteams": {
    "width": "Full"
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Icon",
              "name": "${changeIcon}",
              "size": "xSmall",
              "color": "${changeTone}"
            }
          ],
          "verticalContentAlignment": "Center"
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${who} ${did}",
              "wrap": true,
              "size": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${details}",
      "style": "emphasis",
      "items": [
        {
          "$data": "${details}",
          "type": "TextBlock",
          "text": "${$data}",
          "wrap": true,
          "size": "Small",
          "maxLines": 6
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${id} · ${project}",
              "wrap": true,
              "isSubtle": true,
              "size": "Small"
            },
            {
              "type": "TextBlock",
              "text": "${summary}",
              "wrap": true,
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Badge",
              "$when": "${state}",
              "text": "${state}",
              "style": "${stateStyle}",
              "appearance": "Tint",
              "shape": "Rounded"
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "$when": "${facts}",
      "facts": [
        {
          "$data": "${facts}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "$when": "${canAct}",
      "title": "${words.assignToMe}",
      "verb": "assign",
      "data": {
        "issue": "${id}"
      }
    },
    {
      "type": "Action.ShowCard",
      "$when": "${canMove}",
      "title": "${words.moveTo}",
      "card": {
        "type": "AdaptiveCard",
        "version": "1.5",
        "body": [
          {
            "type": "Input.ChoiceSet",
            "id": "state",
            "label": "${stateField}",
            "value": "${state}",
            "choices": [
              {
                "$data": "${states}",
                "title": "${$data}",
                "value": "${$data}"
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "Action.Execute",
            "title": "${words.move}",
            "verb": "state",
            "data": {
              "issue": "${id}"
            }
          }
        ]
      }
    },
    {
      "type": "Action.OpenUrl",
      "title": "${words.openInA4a}",
      "url": "${url}"
    }
  ]
}
