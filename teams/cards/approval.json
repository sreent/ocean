{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "msteams": {
    "width": "Full"
  },
  "refresh": {
    "action": {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "approval"
    },
    "userIds": [
      "<Priya Nair's Teams user id>"
    ]
  },
  "body": [
    {
      "type": "TextBlock",
      "text": "Ben Okafor asks you to approve a claim",
      "wrap": true,
      "isSubtle": true,
      "size": "Small"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Singapore trip · 4 to 6 Nov",
              "wrap": true,
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "4 expenses, with 3 receipts and 1 card payment",
              "wrap": true,
              "isSubtle": true,
              "size": "Small",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Total",
              "wrap": true,
              "isSubtle": true,
              "size": "Small",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "SGD 777.10",
              "wrap": true,
              "weight": "Bolder",
              "size": "Medium",
              "horizontalAlignment": "Right",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {
          "title": "Purpose",
          "value": "Supplier visit"
        },
        {
          "title": "Prepared by",
          "value": "Expenses, for Ben, who submitted it"
        }
      ]
    },
    {
      "type": "Container",
      "style": "warning",
      "showBorder": true,
      "roundedCorners": true,
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Icon",
                  "name": "Clock",
                  "size": "xSmall",
                  "color": "Warning"
                }
              ],
              "verticalContentAlignment": "Center"
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "1 over policy",
                  "wrap": true,
                  "weight": "Bolder",
                  "color": "Warning"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "Hotel, 2 nights: SGD 20 a night over the SGD 250 cap.",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "Ben's reason: “Conference block rate; no cheaper rooms nearby”",
          "wrap": true,
          "isSubtle": true,
          "size": "Small",
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Approving sends it to Finance, who pay it.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Approve",
      "verb": "approve",
      "style": "positive"
    },
    {
      "type": "Action.Execute",
      "title": "Decline",
      "verb": "decline",
      "style": "destructive"
    },
    {
      "type": "Action.ShowCard",
      "title": "Ask Ben",
      "card": {
        "type": "AdaptiveCard",
        "body": [
          {
            "type": "Input.Text",
            "id": "question",
            "label": "Your question, for Ben",
            "isMultiline": true
          }
        ],
        "actions": [
          {
            "type": "Action.Execute",
            "title": "Send",
            "verb": "ask"
          }
        ]
      }
    }
  ]
}
