{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "msteams": {
    "width": "Full"
  },
  "refresh": {
    "$when": "${refreshFor}",
    "action": {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "refresh",
      "data": {
        "issue": "${id}"
      }
    },
    "userIds": [
      "${refreshFor}"
    ]
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${id} · ${project}",
              "wrap": true,
              "isSubtle": true,
              "size": "Small"
            },
            {
              "type": "TextBlock",
              "text": "${summary}",
              "wrap": true,
              "weight": "Bolder",
              "size": "Medium",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Badge",
              "$when": "${state}",
              "text": "${state}",
              "style": "${stateStyle}",
              "appearance": "Tint",
              "shape": "Rounded"
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "$when": "${facts}",
      "facts": [
        {
          "$data": "${facts}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "ColumnSet",
      "$when": "${note}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Icon",
              "name": "${noteIcon}",
              "size": "xSmall",
              "color": "${noteTone}",
              "style": "Filled"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${note}",
              "wrap": true,
              "size": "Small"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "$when": "${canAct}",
      "title": "Assign to me",
      "verb": "assign",
      "data": {
        "issue": "${id}"
      }
    },
    {
      "type": "Action.ShowCard",
      "$when": "${canMove}",
      "title": "Move to…",
      "card": {
        "type": "AdaptiveCard",
        "version": "1.5",
        "body": [
          {
            "type": "Input.ChoiceSet",
            "id": "state",
            "label": "State",
            "value": "${state}",
            "choices": [
              {
                "$data": "${states}",
                "title": "${$data}",
                "value": "${$data}"
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "Action.Execute",
            "title": "Move",
            "verb": "state",
            "data": {
              "issue": "${id}"
            }
          }
        ]
      }
    },
    {
      "type": "Action.ShowCard",
      "$when": "${canAct}",
      "title": "Comment",
      "card": {
        "type": "AdaptiveCard",
        "version": "1.5",
        "body": [
          {
            "type": "Input.Text",
            "id": "comment",
            "label": "Comment",
            "isMultiline": true,
            "isRequired": true,
            "errorMessage": "Say something to comment",
            "maxLength": 4000
          }
        ],
        "actions": [
          {
            "type": "Action.Execute",
            "title": "Comment",
            "verb": "comment",
            "data": {
              "issue": "${id}"
            }
          }
        ]
      }
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open in a4a",
      "url": "${url}"
    }
  ]
}
