{
  "name": "@sreent/ocean",
  "version": "0.1.0",
  "private": true,
  "description": "Ocean: the look a5s, a7c, a3t and a4a share. Tokens in two layers, IBM Plex, the icons, the pieces' CSS and the chart colours, the conversation kit's cards for Microsoft Teams, and the checks they're held to.",
  "type": "module",
  "exports": {
    "./tokens.css": "./css/tokens.css",
    "./components.css": "./css/components.css",
    "./charts.css": "./css/charts.css",
    "./tokens.json": "./tokens.json",
    "./charts/palettes.json": "./charts/palettes.json",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./teams/*": "./teams/*"
  },
  "files": [
    "css",
    "fonts",
    "icons",
    "charts",
    "teams",
    "tokens.json",
    "scripts/check.mjs",
    "scripts/tokens.mjs"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
